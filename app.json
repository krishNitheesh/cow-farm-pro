{
  "expo": {
    "name": "cow-farm-pro",
    "slug": "cow-farm-pro",
    "scheme": "cowfarm",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/krishna_logo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/krishna_logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#26170d"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.cowfarm.management",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#26170d",
        "foregroundImage": "./assets/krishna_logo.png"
      }
    },
    "web": {
      "favicon": "./assets/krishna_logo.png"
    },
    "extra": {
      "eas": {
        "projectId": "327fe42e-474f-4a3a-a482-6b535e4d282d"
      }
    },
    "plugins": [
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      "expo-sharing"
    ]
  }
}
